# Enterprise API Dockerfile
# 用于构建 Dify 企业版 FastAPI 服务的 Docker 镜像

FROM python:3.12-slim-bookworm

WORKDIR /app

# 加阿里云源
RUN sed -i "s@deb.debian.org@mirrors.aliyun.com@g" /etc/apt/sources.list.d/debian.sources


# Install uv
ENV UV_VERSION=0.8.9
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple uv==${UV_VERSION}

# Install system dependencies for psycopg2
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  libpq-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml and install dependencies from it
COPY enterprise_api/pyproject.toml /app/enterprise_api_pyproject.toml
COPY enterprise_chat_api/pyproject.toml /app/
RUN uv venv /app/.venv
RUN . /app/.venv/bin/activate && uv pip install --no-cache-dir --index-url https://pypi.tuna.tsinghua.edu.cn/simple -r /app/pyproject.toml

# Copy enterprise_api source code
COPY enterprise_api /app/enterprise_api
COPY enterprise_chat_api /app/enterprise_chat_api
COPY models /app/api/models
COPY libs /app/api/libs
COPY configs /app/api/configs
COPY extensions /app/api/extensions
COPY services /app/api/services
COPY core /app/api/core
COPY constants /app/api/constants
COPY enums /app/api/enums
COPY events /app/api/events
COPY factories /app/api/factories
COPY tasks /app/api/tasks
COPY repositories /app/api/repositories
COPY contexts /app/api/contexts
COPY context /app/api/context
COPY enterprise /app/api/enterprise
COPY dify_app.py /app/api/dify_app.py
COPY app_factory.py /app/api/app_factory.py
COPY pyproject.toml /app/api/pyproject.toml

# Set environment variables
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV PYTHONPATH=/app/api

# Set timezone
ENV TZ=UTC
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV PYTHONIOENCODING=utf-8

EXPOSE 5002

# Run the application
CMD ["/app/.venv/bin/uvicorn", "enterprise_api.main:app", "--host", "0.0.0.0", "--port", "5002"]
